DATABASE_URL=postgresql://user:password@host:port/cinema_booking

JWT_SECRET=
JWT_ALGORITHM=HS256

# Debe coincidir con INTERNAL_SERVICE_TOKEN en user-service-cinema y catalog-service-cinema
INTERNAL_SERVICE_TOKEN=

# Kafka (Confluent Cloud)
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_API_KEY=
KAFKA_API_SECRET=
# group_id del consumer de Kafka. Dev y prod comparten el mismo cluster de
# Confluent Cloud -- en local usa SIEMPRE un sufijo distinto (ej. "-local")
# para no unirte al mismo grupo de consumidores que produccion.
KAFKA_GROUP_ID=booking-service-group-local

# URLs de microservicios
# Local (Docker):      http://payment-service:8003
# Producción (Render): https://payment-service-cinema.onrender.com
PAYMENT_SERVICE_URL=

# Local (Docker):      http://catalog-service:8006
# Producción (Render): https://catalog-service-cinema.onrender.com
CATALOG_SERVICE_URL=

# Redis
REDIS_URL=redis://user:password@host:port
